# ════════════════════════════════════════════════════════════════
# COFIRA - Environment variables (TEMPLATE)
# ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#     cp .env.example .env
# The .env file is gitignored and is NEVER pushed to the repository.
# ════════════════════════════════════════════════════════════════

# --- PostgreSQL database ---
DB_USERNAME=admin
# Use a strong, unique password:
DB_PASSWORD=change_this_password

# --- JWT ---
# Generate a fresh secret (at least 64 bytes), for example:
#     openssl rand -hex 64
JWT_SECRET=generate_a_secret_with_openssl_rand_hex_64
JWT_EXPIRATION_MS=86400000

# --- pgAdmin (development only) ---
PGADMIN_EMAIL=admin@cofira.com
PGADMIN_PASSWORD=change_this_password

# --- AI service (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Contact form (optional) ---
# Discord webhook that receives contact form submissions; leave empty to disable.
DISCORD_CONTACTO_WEBHOOK=

